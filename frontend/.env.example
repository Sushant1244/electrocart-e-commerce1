# Frontend Environment Variables Template
# Copy this to .env (local) and set the same keys in Vercel -> Settings -> Environment Variables.

# API base URL.
#   Local dev  : http://127.0.0.1:5001/api   (points at `npm run dev:server`)
#   Production : https://api.rameshprasadsah.com.np   (Render backend, no /api suffix needed)
VITE_API_URL=http://127.0.0.1:5001/api

# Payment gateway (eSewa)
VITE_ESEWA_MERCHANT_ID=your_esewa_merchant_id
VITE_ESEWA_URL=https://esewa.com.np

# App info
VITE_APP_NAME=E-Commerce Store
VITE_APP_URL=https://www.rameshprasadsah.com.np
