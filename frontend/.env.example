# Frontend Environment Variables Template
# Copy this to .env and fill in your actual values

# API Base URL. Use the local backend URL in .env, or the public HTTPS backend URL in production.
VITE_API_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:5001

# Payment Gateway (eSewa)
VITE_ESEWA_MERCHANT_ID=your_esewa_merchant_id
VITE_ESEWA_URL=https://esewa.com.np

# App Info
VITE_APP_NAME=E-Commerce Store
VITE_APP_URL=http://127.0.0.1:5173
