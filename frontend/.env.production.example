# Frontend Production Environment Variables Template
# Copy this to .env.production and fill in your actual values

# API Base URL (Production)
VITE_API_URL=https://your-backend-api.com/api

# Payment Gateway (eSeWa) - Use production merchant ID
VITE_ESEWA_MERCHANT_ID=your_production_esewa_merchant_id
VITE_ESEWA_URL=https://esewa.com.np

# App Info
VITE_APP_NAME=E-Commerce Store
VITE_APP_URL=https://your-domain.com
