# Backend Production Environment Variables Template
# Copy this to .env.production and fill in your actual values

# Server
PORT=5000
NODE_ENV=production

# Database (PostgreSQL) - Use your production DB credentials
DB_HOST=your_production_db_host
DB_USER=your_production_db_user
DB_PASSWORD=your_production_db_password
DB_NAME=ecommerce_production
DB_PORT=5432
DB_SSL=true

# JWT - Use a strong random secret for production
JWT_SECRET=your_production_jwt_secret_min_32_chars
JWT_EXPIRE=7d

# Email (SMTP) - Use production email credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@gmail.com
SMTP_PASS=your_16_char_app_password

# Payment Gateway (eSewa) - Use production merchant credentials
ESEWA_MERCHANT_ID=your_production_esewa_merchant_id
ESEWA_SECRET_KEY=your_production_esewa_secret_key

# Cloud Storage (AWS S3) - Use production S3 credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_production_bucket
AWS_REGION=us-east-1

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com
