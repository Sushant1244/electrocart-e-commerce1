# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

# Server
PORT=5001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ecommerce_db
DB_PORT=5432

# Database (MongoDB Atlas; enables the /api/mongo/* routes and auth)
# MONGODB_URI is the production name; MONGO_URI is accepted as an alias.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sonu_enterprises?retryWrites=true&w=majority
MONGO_URI=
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=2000

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
AUTH_ENCRYPTION_KEY=your_second_long_random_secret_here
JWT_EXPIRE=7d

# Email (SMTP) - Use Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=your_email@gmail.com

# Payment Gateway (eSewa)
ESEWA_MERCHANT_ID=your_esewa_merchant_id
ESEWA_SECRET_KEY=your_esewa_secret_key

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=us-east-1

# Frontend URL (for CORS)
ALLOWED_ORIGINS=https://rameshprasadsah.com.np,https://www.rameshprasadsah.com.np
CLIENT_URL=https://rameshprasadsah.com.np

# MongoDB seed values
ADMIN_EMAIL=admin@sonuenterprises.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
GOOGLE_CLIENT_ID=
